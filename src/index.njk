---
layout: base.njk
description: Product design and UX leader Jon Plummer on design leadership, AI-era product work, and coordinated experience. Formerly Invoca, Cayuse, Belkin, Medtronic.
purpose: blog homepage
pagination:
  data: collections.post
  reverse: true
  size: 5
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/page/{{ pagination.pageNumber }}/{% endif %}"
ogImage: /assets/images/og/v2/index.png
---
{# This page's posts and links, merged in index.11tydata.js #}
{% for item in pageItems %}
    {% if item.type == 'post' %}
        {% set post = item.data %}
        {% include "components/post_content.njk" %}
    {% elif item.type == 'link' %}
        {% set link = item.data %}
        {% include "components/link_item.njk" %}
    {% endif %}
{% endfor %}

<nav class="pagination" aria-label="Post pagination">
    {% if pagination.href.next %}
        <a class="prev" href="{{ pagination.href.next }}">Older posts</a>
    {% endif %}
    {% if pagination.href.previous %}
        <a class="next" href="{{ pagination.href.previous }}">Newer posts</a>
    {% endif %}
</nav>