---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {# Homepage #}
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ collections.post | getNewestCollectionItemDate | dateToRfc3339 }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  {# Index pages take lastmod from what they list, not from their own date. #}
  {% set wisdomLastmod = wisdom.entries[0].added if wisdom.entries.length else (collections.post | getNewestCollectionItemDate) %}
  {% set pageOverrides = {
    "/wisdom/": { lastmod: wisdomLastmod, priority: "0.7" },
    "/portfolio/": { lastmod: collections.portfolio | getNewestCollectionItemDate, priority: "0.8" },
    "/sides/": { lastmod: collections.sideproject | getNewestCollectionItemDate, priority: "0.7" }
  } %}

  {# Pages tagged `page`: this loop is the only place they're written, so none is
     listed twice (guarded by `pnpm run test seo`). Paginated templates are skipped
     because only their first page lands in the collection; they get their own loop.
     Pages with `noindex: true` are left out (guarded by the same test). #}
  {% for page in collections.page %}
  {% if page.data.purpose != "404" and page.data.purpose != "500" and not page.data.pagination and not page.data.noindex %}
  {% set override = pageOverrides[page.url] %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <lastmod>{{ (override.lastmod if override else page.date) | dateToRfc3339 }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{{ override.priority if override else "0.8" }}</priority>
  </url>
  {% endif %}
  {% endfor %}

  {# Wisdom tag pages (paginated, so not in collections.page) #}
  {% for tag in wisdom.allTags %}
  <url>
    <loc>{{ site.url }}/wisdom/tags/{{ tag }}/</loc>
    <lastmod>{{ wisdomLastmod | dateToRfc3339 }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}

  {# All blog posts #}
  {% for post in collections.post %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | dateToRfc3339 }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}

  {# All portfolio items #}
  {% for item in collections.portfolio %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ item.date | dateToRfc3339 }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}

  {# All side projects #}
  {% for item in collections.sideproject %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ item.date | dateToRfc3339 }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}

  {# Pagination pages #}
  {% set totalPosts = collections.post | length %}
  {% set postsPerPage = 5 %}
  {% set totalPages = (totalPosts + postsPerPage - 1) // postsPerPage %}
  {# totalPages includes page 0, so last numbered page is (totalPages - 1) #}
  {# range() excludes upper bound, so use totalPages to generate 1 to (totalPages - 1) #}
  {% for pageNum in range(1, totalPages) %}
  <url>
    <loc>{{ site.url }}/page/{{ pageNum }}/</loc>
    <lastmod>{{ collections.post | getNewestCollectionItemDate | dateToRfc3339 }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endfor %}
</urlset>
