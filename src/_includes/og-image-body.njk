{#-
  OG card markup, shared by:
  - og-image.njk: the document Puppeteer screenshots (generate-og-images.js)
  - ogimages.njk and style-exercise.njk: previews via renderFile

  Styles: /assets/css/og-card.css. Title fitting: /assets/js/og-card-fit.js.
  Spec: docs/designs/specs/2026-10-09-og-dark-card-design.md

  Variables:
  - title: card title (required)
  - label: type label ("Post") or nav path ("/about") (optional)
  - labelIsPath: true when label is a path (lighter weight)

  The mark is inline so it takes the byline color; its rects must match
  /assets/images/jp-mark.svg (the og-card test checks).
-#}
<div class="og-card">
  {%- if label %}
  <p class="og-label{% if labelIsPath %} og-label-path{% endif %}">{{ label }}</p>
  {%- endif %}
  <div class="og-title-box"><p class="og-title">{{ title }}</p></div>
  <p class="og-byline"><svg class="og-mark" viewBox="50 50 500 500" aria-hidden="true" focusable="false"><rect x="50" y="450" width="100" height="100"/><rect x="183" y="50" width="100" height="500"/><rect x="317" y="50" width="100" height="500"/><rect x="450" y="50" width="100" height="400"/></svg>{{ site.author }}</p>
</div>
