{#-
  OG card document – rendered to a 1200×630 PNG by
  scripts/content/generate-og-images.js (Puppeteer). Preview: /ogimages/

  Variables:
  - productionFontFaces: @font-face rules with file:// URLs
  - cssCustomProperties: the site's :root tokens (light-dark() pairs;
    the card resolves them dark)
  - ogCardCss: src/assets/css/og-card.css
  - ogFitScript: src/assets/js/og-card-fit.js
  - plus the og-image-body.njk variables (title, label, labelIsPath, site)
-#}
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <style>
    {{ productionFontFaces | safe }}
    {{ cssCustomProperties | safe }}
    html, body {
      width: 1200px;
      height: 630px;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    {{ ogCardCss | safe }}
  </style>
</head>
<body>
  {% include "og-image-body.njk" %}
  <script>{{ ogFitScript | safe }}</script>
</body>
</html>
