<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- `noindex: true` in front matter keeps a page out of search results; sitemap.njk
    skips the same flag. The page stays linked and crawlable, so search engines can
    read the tag. Don't also block it in robots.txt. -#}
<meta name="robots" content="{% if noindex %}noindex{% else %}max-image-preview:large{% endif %}">
<meta name="generator" content="{{ eleventy.generator }}">
{%- include "head/critical.njk" %}
{#- Asset hrefs are root-absolute, never relative to page.outputPath. ErrorDocument
    pages (404, 500) are served by the webserver at whatever URL failed, not at their
    own output path, so a file-relative path would resolve against that failing URL
    and 404 in turn. Guarded by `pnpm run test error-document-assets`. -#}
<link rel="preload" href="/assets/fonts/lab/libre-franklin-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous">
<link rel="preload" href="/assets/fonts/lab/big-shoulders-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous">
<link rel="stylesheet" type="text/css" href="/assets/css/jonplummer.css">