---
layout: base.njk
title: Open Graph images check
description: Preview Open Graph image templates and generated assets.
permalink: /ogimages/
tags: page
ogImage: /assets/images/og/v2/ogimages.png
---
{#- Card styles and the title-fit script load on the preview pages only #}
<link rel="stylesheet" href="/assets/css/og-card.css">
<script src="/assets/js/og-card-fit.js" defer></script>

<div class="preview-container">
  <div class="preview-info">
    <p>Previews of the OG card (<code>og-image-body.njk</code>, styled by <code>og-card.css</code>, title fitted by <code>og-card-fit.js</code>) at half size and at LinkedIn's feed size, then every generated card. Design: <code>docs/designs/specs/2026-10-09-og-dark-card-design.md</code>.</p>
  </div>

  <div class="preview-section">
    <h2>Card examples</h2>
    <div class="og-preview-wrapper">
      <div class="og-preview-item">
        <h3>Post</h3>
        <div class="og-preview-pair">
          <div class="og-preview-container">
            <div class="og-preview-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Many little diamonds", label: "Post", labelIsPath: false, site: site } %}
            </div>
          </div>
          <div class="og-preview-feed" aria-hidden="true">
            <div class="og-preview-feed-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Many little diamonds", label: "Post", labelIsPath: false, site: site } %}
            </div>
          </div>
        </div>
      </div>

      <div class="og-preview-item">
        <h3>Portfolio piece</h3>
        <div class="og-preview-pair">
          <div class="og-preview-container">
            <div class="og-preview-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Velop whole-home WiFi system", label: "Portfolio", labelIsPath: false, site: site } %}
            </div>
          </div>
          <div class="og-preview-feed" aria-hidden="true">
            <div class="og-preview-feed-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Velop whole-home WiFi system", label: "Portfolio", labelIsPath: false, site: site } %}
            </div>
          </div>
        </div>
      </div>

      <div class="og-preview-item">
        <h3>Side project</h3>
        <div class="og-preview-pair">
          <div class="og-preview-container">
            <div class="og-preview-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Parker", label: "Side project", labelIsPath: false, site: site } %}
            </div>
          </div>
          <div class="og-preview-feed" aria-hidden="true">
            <div class="og-preview-feed-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Parker", label: "Side project", labelIsPath: false, site: site } %}
            </div>
          </div>
        </div>
      </div>

      <div class="og-preview-item">
        <h3>Page (nav-style path)</h3>
        <div class="og-preview-pair">
          <div class="og-preview-container">
            <div class="og-preview-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "About Jon Plummer", label: "/about", labelIsPath: true, site: site } %}
            </div>
          </div>
          <div class="og-preview-feed" aria-hidden="true">
            <div class="og-preview-feed-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "About Jon Plummer", label: "/about", labelIsPath: true, site: site } %}
            </div>
          </div>
        </div>
      </div>

      <div class="og-preview-item">
        <h3>Default card (home, paginated indexes, wisdom tags)</h3>
        <div class="og-preview-pair">
          <div class="og-preview-container">
            <div class="og-preview-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: site.tagline, label: "/", labelIsPath: true, site: site } %}
            </div>
          </div>
          <div class="og-preview-feed" aria-hidden="true">
            <div class="og-preview-feed-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: site.tagline, label: "/", labelIsPath: true, site: site } %}
            </div>
          </div>
        </div>
      </div>

      <div class="og-preview-item">
        <h3>Longest title – fits at the minimum size, then truncates</h3>
        <div class="og-preview-pair">
          <div class="og-preview-container">
            <div class="og-preview-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Confusing terms: globalization, internationalization, translation, localization", label: "Post", labelIsPath: false, site: site } %}
            </div>
          </div>
          <div class="og-preview-feed" aria-hidden="true">
            <div class="og-preview-feed-scaled">
              {% renderFile "./src/_includes/og-image-body.njk", { title: "Confusing terms: globalization, internationalization, translation, localization", label: "Post", labelIsPath: false, site: site } %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if ogImages %}
  <div class="preview-section">
    <h2>All OG Images</h2>
    <p>Every card in <code>src/assets/images/og/v2/</code>, newest content first by front-matter <code>date</code> when there is one.</p>
    
    <div class="og-images-grid">
      {% for image in ogImages %}
      <div class="og-images-grid-item">
        <img src="{{ image.url }}" alt="{{ image.filename }}" loading="lazy">
        <code>{{ image.filename }}</code>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>

